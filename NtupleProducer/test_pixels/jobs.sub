# condor_submit jobs.sub  (queues every line of jobs.txt: sample idx lfn redirector maxEvents)
universe = vanilla
executable = run_job.sh
arguments = $(sample) $(idx) $(lfn) $(redir) $(nev)
use_x509userproxy = True
x509userproxy = /home/submit/novaka/x509up_u248613
output = logs/$(sample)_$(idx).out
error = logs/$(sample)_$(idx).err
log = logs/jobs.log
request_cpus = 4
request_memory = 8000
max_retries = 2
+JobFlavour = "workday"
queue sample, idx, lfn, redir, nev from jobs.txt
